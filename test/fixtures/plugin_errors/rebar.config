%% Fixture for the diagnostic cases. Templates here are broken on purpose;
%% individual cases add and remove them, so the checked-in views/ holds only
%% what every case needs.
{plugins, [rebar3_beamai_render]}.
{deps, [beamai_render]}.
{mustache_opts, [{views, "views"}, {out_dir, "_gen"}, {prefix, "view_"}]}.
{erl_opts, [debug_info, {src_dirs, ["src", "_gen"]}]}.
